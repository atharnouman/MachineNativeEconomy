{
  "name": "@spendmarshal/sdk",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Athar Nouman <atharnouman@gmail.com>",
  "description": "TypeScript SDK for the Agentic Payment Gateway: pay(), simulate(), delegate(), receipts(), exportEvidence(), plus framework-neutral tool definitions",
  "keywords": [
    "agentic payments",
    "sdk",
    "x402",
    "mpp",
    "ai agents",
    "tool definitions"
  ],
  "homepage": "https://github.com/atharnouman/MachineNativeEconomy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharnouman/MachineNativeEconomy.git",
    "directory": "packages/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/atharnouman/MachineNativeEconomy/issues"
  },
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@spendmarshal/core": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
