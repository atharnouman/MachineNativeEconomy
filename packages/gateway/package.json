  "description": "Agentic Payment Gateway service: policy enforcement below the model, session-key signer, x402 + MPP pay-side adapters, local facilitator, signed receipt log, evidence export",
  "keywords": [
    "agentic payments",
    "payment gateway",
    "x402",
    "mpp",
    "policy",
    "ai agents",
    "fastify"
  ],
  "homepage": "https://github.com/atharnouman/MachineNativeEconomy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharnouman/MachineNativeEconomy.git",
    "directory": "packages/gateway"
  },
  "bugs": {
    "url": "https://github.com/atharnouman/MachineNativeEconomy/issues"
  },
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@spendmarshal/core": "workspace:*",
    "better-sqlite3": "^11",
    "fastify": "^5.2.0",
    "pg": "^8.23.1",
    "prom-client": "^15",
    "viem": "^2.21.54",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
