{
  "name": "@spendmarshal/payee",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Athar Nouman <atharnouman@gmail.com>",
  "description": "Accept-side middleware: charge AI agents for any HTTP resource over x402 and MPP with one configuration block, plus an example payee server",
  "keywords": [
    "x402",
    "mpp",
    "l402",
    "402",
    "paywall",
    "ai agents",
    "middleware"
  ],
  "homepage": "https://github.com/atharnouman/MachineNativeEconomy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharnouman/MachineNativeEconomy.git",
    "directory": "packages/payee"
  },
  "bugs": {
    "url": "https://github.com/atharnouman/MachineNativeEconomy/issues"
  },
  "engines": {
    "node": ">=20.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@spendmarshal/core": "workspace:*",
    "fastify": "^5.2.0",
    "viem": "^2.21.54"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
