# Gateway (packages/gateway/src/main.ts). The demo sets all of this in-process; use this for a standalone run.
SPENDMARSHAL_HOST=127.0.0.1
SPENDMARSHAL_PORT=4402
SPENDMARSHAL_RPC_URL=http://127.0.0.1:8545
SPENDMARSHAL_CHAIN_ID=31337
# anvil dev key #0 — never use outside a local chain
SPENDMARSHAL_GATEWAY_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SPENDMARSHAL_SESSION_SECRET=change-me
SPENDMARSHAL_CREDENTIAL_ROOT_KEY=change-me-too
SPENDMARSHAL_ADMIN_TOKEN=dev-admin-token
SPENDMARSHAL_DATA_DIR=./data/gateway
SPENDMARSHAL_STORE=sqlite                      # json | sqlite
SPENDMARSHAL_X402_MODE=agent-account           # agent-account (bundled facilitator, 1 tx) | standard (any facilitator, pre-approval + ERC-1271)
SPENDMARSHAL_APPROVERS={"cfo":"0x..."}         # optional: approver id -> address for signed approvals
SPENDMARSHAL_REQUIRE_SIGNED_APPROVALS=false
SPENDMARSHAL_APPROVAL_TTL=3600
SPENDMARSHAL_PUBLIC_URL=http://127.0.0.1:4402     # advertised as Signature-Agent; serves /.well-known/http-message-signatures-directory
SPENDMARSHAL_SIGN_OUTBOUND=true                   # sign requests to payees as a Web Bot Auth agent
SPENDMARSHAL_OUTBOUND_ALLOW_LOOPBACK=false        # allow payees on this machine (local demos only; the gateway is not a proxy)
SPENDMARSHAL_OUTBOUND_ALLOW_PRIVATE=false         # also allow private, link-local and CGNAT payee hosts (in-cluster payees only)
SPENDMARSHAL_PAYEE_TIMEOUT_MS=15000        # abort any payee request (probe or paid retry) after this many ms
SPENDMARSHAL_OUTBOUND_ALLOWED_HOSTS=              # optional comma list pinning the payee hosts this deployment may ever contact (exact, or *.suffix)
SPENDMARSHAL_LOG_LEVEL=info                       # unset = quiet; secrets are redacted
SPENDMARSHAL_DEFAULT_METRICS=false                # add Node process metrics to /metrics
SPENDMARSHAL_SATS_PER_USDC=1600                   # reference-currency rate for the L402 rail (a Lightning backend must be configured in code)
SPENDMARSHAL_POLICY_PATH=./examples/thin-slice/src/policy.yaml
# from `forge script` / the demo output
SPENDMARSHAL_CONTRACTS={"usdc":"0x...","receiptRegistry":"0x...","enforcers":{"spendLimit":"0x...","timeWindow":"0x...","allowedTargets":"0x..."}}
SPENDMARSHAL_PRINCIPALS={"org-acme":{"account":"0x..."}}

# Example payee (packages/payee/src/main.ts)
PAYEE_PORT=4403
PAYEE_TOKEN=0x...            # USDC address
PAYEE_PAY_TO=0x...           # treasury
PAYEE_FACILITATOR_URL=http://127.0.0.1:4402
PAYEE_RPC_URL=http://127.0.0.1:8545
# anvil dev key #1 — gas only
PAYEE_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# MCP server (packages/mcp-server)
SPENDMARSHAL_URL=http://127.0.0.1:4402
SPENDMARSHAL_CREDENTIAL=<base64url credential from POST /v1/credentials>
