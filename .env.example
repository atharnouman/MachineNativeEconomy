# Gateway (packages/gateway/src/main.ts). The demo sets all of this in-process; use this for a standalone run.
APGW_HOST=127.0.0.1
APGW_PORT=4402
APGW_RPC_URL=http://127.0.0.1:8545
APGW_CHAIN_ID=31337
# anvil dev key #0 — never use outside a local chain
APGW_GATEWAY_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
APGW_SESSION_SECRET=change-me
APGW_CREDENTIAL_ROOT_KEY=change-me-too
APGW_ADMIN_TOKEN=dev-admin-token
APGW_DATA_DIR=./data/gateway
APGW_POLICY_PATH=./examples/thin-slice/src/policy.yaml
# from `forge script` / the demo output
APGW_CONTRACTS={"usdc":"0x...","receiptRegistry":"0x...","enforcers":{"spendLimit":"0x...","timeWindow":"0x...","allowedTargets":"0x..."}}
APGW_PRINCIPALS={"org-acme":{"account":"0x..."}}

# Example payee (packages/payee/src/main.ts)
PAYEE_PORT=4403
PAYEE_TOKEN=0x...            # USDC address
PAYEE_PAY_TO=0x...           # treasury
PAYEE_FACILITATOR_URL=http://127.0.0.1:4402
PAYEE_RPC_URL=http://127.0.0.1:8545
# anvil dev key #1 — gas only
PAYEE_RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# MCP server (packages/mcp-server)
APGW_URL=http://127.0.0.1:4402
APGW_CREDENTIAL=<base64url credential from POST /v1/credentials>
